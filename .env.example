# Local model runtime
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional web/image search
SERPER_API_KEY=

# Databases: use aliases. Secrets stay in environment variables.
DB_MAIN_URL=
DB_ANALYTICS_URL=

# Optional local API bearer token. If empty, API is still localhost-only by default.
ASSISTANT_API_TOKEN=

# Voice/browser extras use local OS permissions and assistant config; no cloud key is required by default.
# Keep routines.allow_model_wake=false unless you explicitly want scheduled prompts to load the local model.

# Personal operating timezone. Use local or an IANA name such as Asia/Kolkata.
ASSISTANT_TIMEZONE=local

# v0.12 connector examples. Use your connector's env_prefix; do not commit real values.
# WORK_GOOGLE_CLIENT_ID=
# WORK_GOOGLE_CLIENT_SECRET=
# WORK_GOOGLE_ACCESS_TOKEN=
# WORK_MS_CLIENT_ID=
# WORK_MS_ACCESS_TOKEN=
# GITHUB_CLIENT_ID=
# GITHUB_ACCESS_TOKEN=
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# NOTION_TOKEN=
