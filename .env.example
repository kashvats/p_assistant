# Local model runtime
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional web/image search
SERPER_API_KEY=

# Databases: use aliases. Secrets stay in environment variables.
DB_MAIN_URL=
DB_ANALYTICS_URL=

# Optional local API bearer token. If empty, API is still localhost-only by default.
ASSISTANT_API_TOKEN=

# Voice/browser extras use local OS permissions and assistant config; no cloud key is required by default.
# Keep routines.allow_model_wake=false unless you explicitly want scheduled prompts to load the local model.
